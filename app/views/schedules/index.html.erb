<div class="bg-white rounded-2xl shadow p-8">
  <div class="text-center mb-8">
    <div class="text-5xl mb-2">📅</div>
    <h1 class="text-2xl font-bold">Work Schedule → Calendar</h1>
    <p class="text-gray-500 mt-1">Upload an image or CSV of your schedule, review shifts, then export</p>
  </div>

  <%# Upload stage %>
  <div id="stage-upload">
    <label id="drop-zone" class="block border-2 border-dashed border-indigo-300 rounded-xl p-12 text-center cursor-pointer hover:border-indigo-500 transition">
      <div id="upload-placeholder">
        <div class="text-5xl mb-3">🖼️</div>
        <p class="font-semibold text-gray-600">Click to upload your schedule</p>
        <p class="text-sm text-gray-400 mt-1">JPG, PNG, WEBP, screenshot or CSV</p>
      </div>
      <img id="preview-img" class="hidden max-h-64 mx-auto rounded-lg shadow" />
      <p id="csv-name" class="hidden text-indigo-700 font-semibold mt-2"></p>
      <input type="file" id="file-input" accept="image/*,.csv,text/csv" class="hidden" />
    </label>

    <div id="upload-actions" class="hidden flex gap-3 justify-center mt-4">
      <button onclick="clearFile()" class="px-5 py-2 rounded-lg border border-gray-300 bg-white">Change file</button>
      <button id="analyse-btn" onclick="uploadFile()" class="px-5 py-2 rounded-lg bg-indigo-600 text-white font-semibold">Analyse Schedule →</button>
    </div>
    <p id="upload-error" class="text-red-500 text-center mt-3 hidden"></p>
  </div>

  <%# Analysing stage %>
  <div id="stage-analysing" class="hidden text-center py-16">
    <div class="text-5xl inline-block animate-spin">⚙️</div>
    <p class="text-lg font-semibold text-gray-600 mt-4">Analysing your schedule…</p>
    <p class="text-gray-400">Usually takes 5–10 seconds</p>
  </div>

  <%# Review stage %>
  <div id="stage-review" class="hidden">
    <div class="flex justify-between items-center mb-3">
      <h2 id="review-title" class="font-bold text-lg"></h2>
      <button onclick="addShift()" class="px-3 py-1.5 rounded-lg border border-indigo-500 bg-indigo-50 text-indigo-600 font-semibold text-sm">+ Add Shift</button>
    </div>
    <div class="overflow-x-auto rounded-xl border border-gray-200">
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="p-2 text-left font-semibold text-gray-700">Title</th>
            <th class="p-2 text-left font-semibold text-gray-700">Start</th>
            <th class="p-2 text-left font-semibold text-gray-700">End</th>
            <th class="p-2 text-center font-semibold text-gray-700">Del</th>
          </tr>
        </thead>
        <tbody id="shifts-tbody"></tbody>
      </table>
    </div>
    <div class="flex gap-3 justify-end mt-4">
      <button onclick="reset()" class="px-5 py-2 rounded-lg border border-gray-300 bg-white">← Start over</button>
      <button onclick="goToExport()" class="px-5 py-2 rounded-lg bg-indigo-600 text-white font-semibold">Export Files →</button>
    </div>
  </div>

  <%# Export stage %>
  <div id="stage-done" class="hidden">
    <div class="text-center mb-6">
      <div class="text-4xl mb-2">✅</div>
      <h2 class="text-xl font-bold">Download your files</h2>
    </div>

    <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-5 mb-4 text-center">
      <p class="font-semibold text-indigo-800 mb-3">📅 ICS — Google / Apple / Outlook Calendar</p>
      <button onclick="downloadFile('ics')" class="px-6 py-2.5 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700">
        Download work-schedule.ics
      </button>
      <p class="text-xs text-gray-500 mt-2">Google Calendar → ⚙️ Settings → Import & Export → Select file → Import</p>
    </div>

    <div class="bg-sky-50 border border-sky-200 rounded-xl p-5 mb-6 text-center">
      <p class="font-semibold text-sky-800 mb-3">📊 CSV — Excel / Google Sheets</p>
      <button onclick="downloadFile('csv')" class="px-6 py-2.5 bg-sky-600 text-white rounded-lg font-semibold hover:bg-sky-700">
        Download work-schedule.csv
      </button>
    </div>

    <div class="text-center">
      <button onclick="reset()" class="px-6 py-2.5 bg-indigo-600 text-white rounded-lg font-semibold">Upload another schedule</button>
    </div>
  </div>
</div>

<%# Recent history %>
<% if @schedules.any? %>
  <div class="mt-8 bg-white rounded-2xl shadow p-6">
    <h2 class="font-bold text-lg mb-4">Recent Schedules</h2>
    <ul class="divide-y divide-gray-100">
      <% @schedules.each do |s| %>
        <li class="py-3 flex justify-between items-center">
          <div>
            <p class="font-medium text-sm"><%= s.original_filename %></p>
            <p class="text-xs text-gray-400"><%= s.shifts.length %> shifts · <%= s.created_at.strftime("%d %b %Y %H:%M") %></p>
          </div>
          <div class="flex gap-2">
            <%= link_to "View", schedule_path(s), class: "text-sm text-indigo-600 hover:underline" %>
            <%= button_to "Delete", delete_schedule_path(s), method: :delete, class: "text-sm text-red-500 hover:underline bg-transparent border-0 cursor-pointer p-0" %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<script>
  let shifts = [];
  let scheduleId = null;
  let selectedFile = null;

  document.getElementById("file-input").addEventListener("change", e => {
    selectedFile = e.target.files[0];
    if (!selectedFile) return;
    const isCSV = selectedFile.name.endsWith(".csv") || selectedFile.type === "text/csv";
    if (isCSV) {
      document.getElementById("csv-name").textContent = "📄 " + selectedFile.name;
      document.getElementById("csv-name").classList.remove("hidden");
      document.getElementById("upload-placeholder").classList.add("hidden");
      document.getElementById("analyse-btn").textContent = "Upload CSV →";
    } else {
      const url = URL.createObjectURL(selectedFile);
      document.getElementById("preview-img").src = url;
      document.getElementById("preview-img").classList.remove("hidden");
      document.getElementById("upload-placeholder").classList.add("hidden");
      document.getElementById("analyse-btn").textContent = "Analyse Schedule →";
    }
    document.getElementById("upload-actions").classList.remove("hidden");
  });

  document.getElementById("drop-zone").addEventListener("click", e => {
    if (["drop-zone","upload-placeholder"].includes(e.target.id))
      document.getElementById("file-input").click();
  });

  function show(stage) {
    ["upload","analysing","review","done"].forEach(s =>
      document.getElementById("stage-"+s).classList.add("hidden"));
    document.getElementById("stage-"+stage).classList.remove("hidden");
  }

  async function uploadFile() {
    if (!selectedFile) return;
    show("analysing");
    const fd = new FormData();
    fd.append("file", selectedFile);
    try {
      const res = await fetch("/schedules", {
        method: "POST",
        headers: { "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content },
        body: fd
      });
      const data = await res.json();
      if (data.error) throw new Error(data.error);
      shifts = data.shifts;
      scheduleId = data.id;
      renderShifts();
      show("review");
    } catch(e) {
      show("upload");
      const err = document.getElementById("upload-error");
      err.textContent = "Error: " + e.message;
      err.classList.remove("hidden");
    }
  }

  function renderShifts() {
    const tbody = document.getElementById("shifts-tbody");
    document.getElementById("review-title").textContent =
      `${shifts.length} shift${shifts.length !== 1 ? "s" : ""} found — review & edit`;
    tbody.innerHTML = "";
    shifts.forEach((s, i) => {
      const tr = document.createElement("tr");
      tr.className = "border-t border-gray-100";
      tr.innerHTML = `
        <td class="p-2"><input class="w-full border border-gray-200 rounded px-2 py-1 text-sm" value="${s.title}" onchange="shifts[${i}].title=this.value"/></td>
        <td class="p-2"><input type="datetime-local" class="border border-gray-200 rounded px-2 py-1 text-sm" value="${s.start}" onchange="shifts[${i}].start=this.value"/></td>
        <td class="p-2"><input type="datetime-local" class="border border-gray-200 rounded px-2 py-1 text-sm" value="${s.end}" onchange="shifts[${i}].end=this.value"/></td>
        <td class="p-2 text-center"><button onclick="deleteShift(${i})" class="bg-red-100 text-red-600 rounded px-2 py-1 font-bold text-xs">✕</button></td>`;
      tbody.appendChild(tr);
    });
  }

  function addShift() {
    const t = new Date(), p = n => String(n).padStart(2,"0");
    const base = `${t.getFullYear()}-${p(t.getMonth()+1)}-${p(t.getDate())}`;
    shifts.push({ title: "Work Shift", start: `${base}T09:00`, end: `${base}T17:00` });
    renderShifts();
  }

  function deleteShift(i) { shifts.splice(i,1); renderShifts(); }

  function goToExport() { show("done"); }

  async function downloadFile(fmt) {
    const fd = new FormData();
    fd.append("shifts", JSON.stringify(shifts));
    fd.append("format", fmt);
    const res = await fetch(`/schedules/${scheduleId}/export`, {
      method: "POST",
      headers: { "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content },
      body: fd
    });
    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = `work-schedule.${fmt}`; a.click();
    URL.revokeObjectURL(url);
  }

  function clearFile() {
    selectedFile = null; scheduleId = null;
    document.getElementById("file-input").value = "";
    document.getElementById("preview-img").classList.add("hidden");
    document.getElementById("csv-name").classList.add("hidden");
    document.getElementById("upload-placeholder").classList.remove("hidden");
    document.getElementById("upload-actions").classList.add("hidden");
    document.getElementById("upload-error").classList.add("hidden");
  }

  function reset() { shifts = []; clearFile(); show("upload"); }
</script>